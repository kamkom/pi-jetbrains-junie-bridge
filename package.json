  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamkom/pi-junie-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/kamkom/pi-junie-bridge/issues"
  },
  "homepage": "https://github.com/kamkom/pi-junie-bridge#readme",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "index.ts",
    "lib/",
    "docs/",
